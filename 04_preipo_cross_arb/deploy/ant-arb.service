[Unit]
Description=ANT Cross-Venue Real Arbitrage Live Bot (Hyperliquid vs OKX)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/nautilus_cluster/ant_arb
# 活引擎只有 v4；legacy/ 下三代引擎已废弃，绝不可放进 ExecStart
ExecStart=/opt/nautilus_cluster/venv/bin/python /opt/nautilus_cluster/ant_arb/ant_cross_arb_v4_adaptive.py
Restart=always
RestartSec=5
StandardOutput=append:/opt/nautilus_cluster/ant_arb/ant_arb.log
StandardError=append:/opt/nautilus_cluster/ant_arb/ant_arb.err

[Install]
WantedBy=multi-user.target
